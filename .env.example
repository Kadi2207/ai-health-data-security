# Copier ce fichier en .env puis remplacer les valeurs. Ne JAMAIS versionner .env.

# Clé secrète Fernet (AES-128-CBC + HMAC-SHA256), utilisée aussi pour signer les sessions Flask.
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_secret_key_here

# Connexion PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tcim_medical
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
